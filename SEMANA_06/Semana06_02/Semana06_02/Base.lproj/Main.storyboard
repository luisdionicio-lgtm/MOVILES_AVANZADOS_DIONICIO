<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25098" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="cliente-vc">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25073"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="cliente-scene">
            <objects>
                <viewController id="cliente-vc" customClass="ViewController" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="cliente-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="form-stack">
                                <rect key="frame" x="24" y="178" width="345" height="318"/>
                                <subviews>
                                    <label opaque="NO" contentMode="left" text="DATOS DEL CLIENTE" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="titulo-1">
                                        <rect key="frame" x="0.0" y="0.0" width="345" height="36"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="36" id="title-height"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="24"/>
                                    </label>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="10" translatesAutoresizingMaskIntoConstraints="NO" id="row-a">
                                        <rect key="frame" x="0.0" y="60" width="345" height="44"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" text="Apellidos" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-a">
                                                <rect key="frame" x="0.0" y="11.999999999999998" width="92" height="20.333333333333329"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="92" id="la-width"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="line" placeholder="Ingrese apellidos" translatesAutoresizingMaskIntoConstraints="NO" id="field-a">
                                                <rect key="frame" x="102" y="7" width="243" height="30"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                <textInputTraits key="textInputTraits"/>
                                            </textField>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="ra-height"/>
                                        </constraints>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="10" translatesAutoresizingMaskIntoConstraints="NO" id="row-n">
                                        <rect key="frame" x="0.0" y="128" width="345" height="44"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" text="Nombres" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-n">
                                                <rect key="frame" x="0.0" y="11.999999999999998" width="92" height="20.333333333333329"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="92" id="ln-width"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="line" placeholder="Ingrese nombres" translatesAutoresizingMaskIntoConstraints="NO" id="field-n">
                                                <rect key="frame" x="102" y="7" width="243" height="30"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                <textInputTraits key="textInputTraits"/>
                                            </textField>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="rn-height"/>
                                        </constraints>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="10" translatesAutoresizingMaskIntoConstraints="NO" id="row-d">
                                        <rect key="frame" x="0.0" y="196" width="345" height="44"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" text="DNI" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-d">
                                                <rect key="frame" x="0.0" y="11.999999999999998" width="92" height="20.333333333333329"/>
                                                <constraints>
                                                    <constraint firstAttribute="width" constant="92" id="ld-width"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="line" placeholder="8 dígitos" translatesAutoresizingMaskIntoConstraints="NO" id="field-d">
                                                <rect key="frame" x="102" y="7" width="243" height="30"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                                <textInputTraits key="textInputTraits" keyboardType="numberPad"/>
                                            </textField>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="rd-height"/>
                                        </constraints>
                                    </stackView>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="continue-button">
                                        <rect key="frame" x="0.0" y="264" width="345" height="54"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="54" id="button-height"/>
                                        </constraints>
                                        <color key="tintColor" systemColor="systemGreenColor"/>
                                        <inset key="imageEdgeInsets" minX="0.0" minY="0.0" maxX="2.2250738585072014e-308" maxY="0.0"/>
                                        <state key="normal" title="Continuar"/>
                                        <buttonConfiguration key="configuration" style="filled" title="Continuar"/>
                                        <connections>
                                            <action selector="btnContinuar:" destination="cliente-vc" eventType="touchUpInside" id="act-cont"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-cliente"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="form-stack" firstAttribute="leading" secondItem="safe-cliente" secondAttribute="leading" constant="24" id="form-leading"/>
                            <constraint firstItem="form-stack" firstAttribute="top" secondItem="safe-cliente" secondAttribute="top" constant="60" id="form-top"/>
                            <constraint firstItem="safe-cliente" firstAttribute="trailing" secondItem="form-stack" secondAttribute="trailing" constant="24" id="form-trailing"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="tfApellido" destination="field-a" id="out-a"/>
                        <outlet property="tfDni" destination="field-d" id="out-d"/>
                        <outlet property="tfNombre" destination="field-n" id="out-n"/>
                        <segue destination="confirm-vc" kind="presentation" identifier="mostrarConfirmacion" modalPresentationStyle="pageSheet" id="modal-confirmacion"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-cliente" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="100"/>
        </scene>
        <!--View Controller Confirmacion-->
        <scene sceneID="confirm-scene">
            <objects>
                <viewController storyboardIdentifier="ViewControllerConfirmacion" id="confirm-vc" customClass="ViewControllerConfirmacion" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="confirm-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="confirm-stack">
                                <rect key="frame" x="32" y="158" width="329" height="278"/>
                                <subviews>
                                    <label opaque="NO" contentMode="scaleToFill" text="DATOS INGRESADOS" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="titulo-2">
                                        <rect key="frame" x="0.0" y="0.0" width="329" height="36"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="36" id="ct-height"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="24"/>
                                    </label>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="c-row-a">
                                        <rect key="frame" x="0.0" y="60" width="329" height="32"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="1000" horizontalCompressionResistancePriority="1000" text="Apellidos:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ca">
                                                <rect key="frame" x="0.0" y="5.9999999999999982" width="74.666666666666671" height="20.333333333333329"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" contentMode="scaleToFill" text="" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-apellido">
                                                <rect key="frame" x="82.666666666666671" y="0.0" width="246.33333333333331" height="32"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="32" id="cra-height"/>
                                        </constraints>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="c-row-n">
                                        <rect key="frame" x="0.0" y="116" width="329" height="32"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" ambiguous="YES" text="Nombres:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cn">
                                                <rect key="frame" x="0.0" y="5.9999999999999982" width="74.333333333333329" height="20.333333333333329"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" contentMode="scaleToFill" ambiguous="YES" text="" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-nombre">
                                                <rect key="frame" x="82.333333333333329" y="0.0" width="246.66666666666669" height="32"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="32" id="crn-height"/>
                                        </constraints>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="c-row-d">
                                        <rect key="frame" x="0.0" y="172" width="329" height="32"/>
                                        <subviews>
                                            <label opaque="NO" contentMode="scaleToFill" ambiguous="YES" text="DNI:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cd">
                                                <rect key="frame" x="0.0" y="5.9999999999999982" width="33" height="20.333333333333329"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" contentMode="scaleToFill" ambiguous="YES" text="" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-dni">
                                                <rect key="frame" x="41" y="0.0" width="288" height="32"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="32" id="crd-height"/>
                                        </constraints>
                                    </stackView>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="close-button">
                                        <rect key="frame" x="0.0" y="228" width="329" height="50"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="50" id="close-height"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" name=".AppleSystemUIFont" family=".AppleSystemUIFont" pointSize="15"/>
                                        <color key="tintColor" systemColor="systemRedColor"/>
                                        <state key="normal" title="Cerrar">
                                            <color key="titleColor" systemColor="labelColor"/>
                                        </state>
                                        <buttonConfiguration key="configuration" style="filled" title="Volver"/>
                                        <connections>
                                            <action selector="btnCerrar:" destination="confirm-vc" eventType="touchUpInside" id="act-close"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-confirm"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="confirm-stack" firstAttribute="leading" secondItem="safe-confirm" secondAttribute="leading" constant="32" id="confirm-leading"/>
                            <constraint firstItem="confirm-stack" firstAttribute="top" secondItem="safe-confirm" secondAttribute="top" constant="40" id="confirm-top"/>
                            <constraint firstItem="safe-confirm" firstAttribute="trailing" secondItem="confirm-stack" secondAttribute="trailing" constant="32" id="confirm-trailing"/>
                        </constraints>
                    </view>
                    <connections>
